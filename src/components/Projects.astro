---
// Projects.astro - Featured Open Source & Production Engineering Projects for Huy NQ
interface Project {
  title: string;
  repoName: string;
  category: string;
  badge: string;
  description: string;
  highlights: string[];
  techStack: string[];
  githubUrl: string;
  stars?: string;
  stats?: { label: string; value: string }[];
}

const projects: Project[] = [
  {
    title: 'Conversion Platform',
    repoName: 'conversion-plf',
    category: 'Backend Microservice & Media Engine',
    badge: 'Microservice',
    description: 'Hệ thống dịch vụ backend chuyên biệt giải quyết bài toán chuyển đổi và tạo tài liệu PDF động từ template, nén và xử lý hình ảnh tối ưu hàng loạt, xuất file báo cáo Excel dung lượng lớn thông qua chuẩn RESTful API.',
    highlights: [
      'Xử lý luồng tạo file PDF động phi đồng bộ với mức tiêu thụ RAM tối ưu',
      'Engine nén hình ảnh tự động duy trì chất lượng sắc nét',
      'Kiến trúc microservice sẵn sàng scale với Docker container'
    ],
    techStack: ['Java 17', 'Spring Boot 3', 'REST API', 'PDF Engine', 'ImageIO', 'Docker'],
    githubUrl: 'https://github.com/huynq11019/conversion-plf',
    stats: [
      { label: 'Latency', value: '< 200ms' },
      { label: 'Architecture', value: 'Microservice' },
      { label: 'Language', value: 'Java 17' }
    ]
  },
  {
    title: 'P2P Chat Application',
    repoName: 'P2P-Chat-App',
    category: 'Real-time WebRTC & Mobile',
    badge: 'P2P Security',
    description: 'Nền tảng giao tiếp trực tiếp thời gian thực bảo mật cao dựa trên kiến trúc Peer-to-Peer. Sử dụng WebRTC và PeerJS để thiết lập kênh truyền dữ liệu trực tiếp giữa 2 thiết bị mà không trung chuyển qua cơ sở dữ liệu máy chủ trung gian.',
    highlights: [
      'Giao tiếp mã hóa ngang hàng E2E bảo đảm quyền riêng tư tuyệt đối',
      'Máy chủ không lưu vết (Zero server-side message persistence)',
      'Hỗ trợ đa nền tảng Responsive Web & Mobile với Ionic Capacitor'
    ],
    techStack: ['Angular', 'TypeScript', 'Ionic', 'Capacitor', 'PeerJS', 'WebRTC', 'Tailwind CSS'],
    githubUrl: 'https://github.com/huynq11019/P2P-Chat-App',
    stats: [
      { label: 'Protocol', value: 'WebRTC P2P' },
      { label: 'Cross-platform', value: 'Web + Mobile' },
      { label: 'Framework', value: 'Angular' }
    ]
  },
  {
    title: 'Pose Guide AI',
    repoName: 'pose-guide',
    category: 'On-Device Computer Vision & Mobile',
    badge: 'AI / Mobile',
    description: 'Ứng dụng di động đa nền tảng hỗ trợ người tập nhận diện và đánh giá tư thế thể chất theo thời gian thực. Ứng dụng mô hình Computer Vision / Pose Estimation chạy trực tiếp trên thiết bị (on-device) để phân tích góc khớp và đưa ra phản hồi tức thì.',
    highlights: [
      'Ước tính khung xương người (Skeletal Pose Estimation) thời gian thực mượt mà',
      'Xử lý on-device hoàn toàn bảo mật hình ảnh và camera cá nhân',
      'Kiến trúc cross-platform tối ưu hóa luồng frame camera với Flutter & Dart'
    ],
    techStack: ['Flutter', 'Dart', 'Computer Vision', 'ML Kit', 'Camera Stream', 'On-Device AI'],
    githubUrl: 'https://github.com/huynq11019/pose-guide',
    stats: [
      { label: 'FPS Target', value: '30+ FPS' },
      { label: 'Execution', value: 'On-Device AI' },
      { label: 'Toolkit', value: 'Flutter' }
    ]
  }
];
---

<section id="projects" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Ambient background glow behind projects -->
  <div class="pointer-events-none absolute top-1/2 left-1/4 -translate-y-1/2 w-[550px] h-[550px] bg-indigo-600/[0.04] rounded-full blur-[150px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-10 right-1/4 w-[450px] h-[450px] bg-blue-600/[0.04] rounded-full blur-[130px]" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-indigo-500/20 bg-indigo-500/[0.06] text-indigo-400 text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm shadow-indigo-500/10">
        <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
        </svg>
        <span>Featured Engineering Work</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Dự án tiêu biểu &amp; Mã nguồn mở
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl leading-relaxed">
        Các giải pháp phần mềm thực chiến, dịch vụ backend và ứng dụng di động được nghiên cứu và hiện thực hóa bởi Huy NQ.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {projects.map((project, idx) => (
        <div class="glass-panel glow-hover group relative rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 border border-white/[0.08] hover:border-blue-500/40 bg-[#0b101c]/85 hover:-translate-y-1">
          <!-- Ambient gradient corner -->
          <div class="absolute top-0 right-0 w-36 h-36 bg-gradient-to-bl from-blue-500/10 via-indigo-500/5 to-transparent rounded-tr-2xl pointer-events-none group-hover:from-blue-500/20 transition-all duration-500"></div>

          <div>
            <!-- Header bar inside card: Category & GitHub Icon Link -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-mono font-medium text-cyan-400 bg-cyan-400/[0.08] border border-cyan-400/20">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                {project.badge}
              </span>
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-lg text-slate-400 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.06] hover:border-slate-500 transition-colors"
                aria-label={`GitHub repository for ${project.title}`}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>

            <!-- Title & Subcategory -->
            <h3 class="text-xl font-bold text-white group-hover:text-blue-300 transition-colors mb-1">
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4 focus:outline-none">
                {project.title}
              </a>
            </h3>
            <p class="text-xs font-mono text-slate-400 mb-4">{project.category}</p>

            <!-- Description -->
            <p class="text-sm text-slate-300/90 leading-relaxed mb-6 font-normal">
              {project.description}
            </p>

            <!-- Key Feature Bullet Points -->
            <div class="space-y-2 mb-6">
              {project.highlights.map((item) => (
                <div class="flex items-start gap-2 text-xs text-slate-400 leading-snug">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span>{item}</span>
                </div>
              ))}
            </div>

            <!-- Architecture / Performance Stats -->
            {project.stats && (
              <div class="grid grid-cols-3 gap-2 py-3 px-3 rounded-xl bg-white/[0.02] border border-white/[0.05] mb-6 font-mono text-center">
                {project.stats.map((stat) => (
                  <div class="flex flex-col">
                    <span class="text-[10px] text-slate-500 uppercase tracking-wider">{stat.label}</span>
                    <span class="text-xs font-semibold text-slate-200 mt-0.5">{stat.value}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Bottom Footer: Tech Stack Pills & GitHub CTA Button -->
          <div class="pt-4 border-t border-white/[0.06] space-y-4">
            <!-- Tech Pills -->
            <div class="flex flex-wrap gap-1.5">
              {project.techStack.map((tech) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-white/[0.04] text-slate-300 border border-white/[0.06] group-hover:border-white/[0.1] transition-colors">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Action Button -->
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-200 bg-white/[0.04] hover:bg-blue-600 hover:text-white border border-white/[0.08] hover:border-transparent transition-all duration-200 shadow-sm group-hover:shadow-blue-500/20"
            >
              <span>Xem mã nguồn trên GitHub</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Callout to full GitHub Profile -->
    <div class="mt-14 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 px-6 py-3.5 rounded-2xl glass-panel border border-white/[0.08] bg-[#0b101c]/70 text-slate-300 text-sm">
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          <span>Khám phá thêm các repository và mã nguồn thực nghiệm khác:</span>
        </span>
        <a
          href="https://github.com/huynq11019?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-blue-400 hover:text-cyan-300 underline underline-offset-4 flex items-center gap-1 transition-colors"
        >
          <span>github.com/huynq11019</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
