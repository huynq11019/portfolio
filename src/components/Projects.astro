---

<section id="projects" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Ambient background glow behind projects -->
  <div class="pointer-events-none absolute top-1/4 left-1/4 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/[0.04] rounded-full blur-[160px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-1/4 right-1/4 w-[550px] h-[550px] bg-indigo-600/[0.04] rounded-full blur-[150px]" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Main Section Header -->
    <div class="flex flex-col items-center text-center mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-blue-500/20 bg-blue-500/[0.06] text-blue-400 text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm shadow-blue-500/10">
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
        </svg>
        <span>Featured Engineering &amp; Solutions</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Dự án &amp; Giải pháp Kỹ thuật
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl leading-relaxed">
        Tổng hợp các giải pháp phân tán cấp Doanh nghiệp trong lĩnh vực Ngân hàng, Fintech, Viễn thông cùng các dự án Mã nguồn mở thực nghiệm của Nguyễn Quang Huy.
      </p>
    </div>

    <!-- ========================================== -->
    <!-- SECTION 1: ENTERPRISE & BANKING SOLUTIONS  -->
    <!-- ========================================== -->
    <div class="mb-20 sm:mb-24">
      <!-- Section 1 Sub-header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 pb-4 border-b border-white/[0.06]">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-400 mb-2">
            <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A48.604 48.604 0 0012 9.75c-2.551 0-5.056.2-7.5.583V21h15z" />
            </svg>
            <span>Enterprise &amp; Banking Solutions</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Dự án Doanh nghiệp tiêu biểu
          </h3>
        </div>
        <p class="text-sm text-slate-400 max-w-md">
          Các hệ thống vi dịch vụ phân tán chịu tải lớn, tuân thủ nguyên tắc Domain-Driven Design (DDD/CQRS) và tiêu chuẩn an toàn thông tin khắt khe.
        </p>
      </div>

      <!-- Enterprise Projects Grid (2x2) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
        {enterpriseProjects.map((project) => (
          <div class={`glass-panel glow-hover group relative rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 border border-white/[0.08] ${project.borderHover} bg-[#0b101c]/80 hover:-translate-y-1`}>
            <!-- Ambient gradient corner -->
            <div class={`absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl ${project.accentGradient} rounded-tr-2xl pointer-events-none group-hover:scale-110 transition-transform duration-500`}></div>

            <div>
              <!-- Top Badges Row -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-medium ${project.clientBadgeColor}`}>
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    {project.client}
                  </span>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-medium text-slate-300 bg-white/[0.04] border border-white/[0.08]">
                    {project.domainBadge}
                  </span>
                </div>
                <div class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-400 bg-white/[0.02] px-2.5 py-1 rounded-md border border-white/[0.05]">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
                  </svg>
                  <span>{project.period}</span>
                </div>
              </div>

              <!-- Project Title & Subtitle -->
              <h4 class="text-xl sm:text-2xl font-bold text-white group-hover:text-blue-300 transition-colors mb-1">
                {project.title}
              </h4>
              <p class="text-xs font-mono text-slate-400 mb-4">{project.subtitle}</p>

              <!-- Role & Team Size Strip -->
              <div class="flex flex-wrap items-center gap-3 py-2 px-3 rounded-lg bg-white/[0.02] border border-white/[0.05] mb-5 text-xs">
                <div class="flex items-center gap-1.5 text-slate-300">
                  <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                  </svg>
                  <span class="text-slate-400">Vai trò:</span>
                  <span class="font-semibold text-white">{project.role}</span>
                </div>
                <span class="text-white/[0.15] hidden sm:inline">•</span>
                <div class="flex items-center gap-1.5 text-slate-300">
                  <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
