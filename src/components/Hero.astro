---
// Hero.astro - Interactive Hero Section with Typewriter Effect, Badges, and Terminal Showcase
---

<section id="hero" class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Hero Intro & Actions -->
      <div class="lg:col-span-7 flex flex-col items-start text-left z-10">
        
        <!-- Sub-badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-blue-500/25 bg-blue-500/[0.08] backdrop-blur-md shadow-sm shadow-blue-500/10 mb-6 group hover:border-blue-400/40 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
          <span class="text-xs sm:text-sm font-medium tracking-wide text-blue-300 group-hover:text-blue-200 transition-colors">
            Backend & Full-Stack Software Engineer
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.25rem] font-extrabold tracking-tight text-white leading-[1.18] mb-6">
          Xây dựng hệ thống <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-cyan-300">backend hiệu năng cao</span> &amp; giải pháp phần mềm hiện đại.
        </h1>

        <!-- Typewriter Rotating Keywords -->
        <div class="flex items-center gap-2 font-mono text-sm sm:text-base lg:text-lg text-slate-300 mb-6 bg-slate-900/60 border border-white/[0.07] px-4 py-2 rounded-xl backdrop-blur-sm min-h-[44px] max-w-full overflow-hidden">
          <span class="text-cyan-400 font-bold select-none">&gt;</span>
          <span class="text-slate-400 shrink-0 font-medium">Chuyên sâu:</span>
          <div class="flex items-center overflow-hidden">
            <span
              id="hero-typewriter"
              class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-400 font-semibold font-mono tracking-tight"
              aria-live="polite"
            >
              Java &amp; Spring Boot
            </span>
            <span id="hero-typewriter-cursor" class="inline-block w-2 h-4 sm:h-5 bg-cyan-400 rounded-sm ml-1 animate-pulse" aria-hidden="true"></span>
          </div>
        </div>

        <!-- Bio Paragraph -->
        <p class="text-base sm:text-lg text-slate-300/90 leading-relaxed mb-8 max-w-2xl font-normal">
          Kỹ sư phần mềm với định hướng kiến trúc phân tán (distributed systems), tối ưu hóa luồng xử lý dữ liệu và xây dựng API backend độ trễ thấp, tính khả dụng cao. Kết hợp năng lực full-stack vững vàng với hệ sinh thái frontend hiện đại và tích hợp hạ tầng đám mây tin cậy.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <!-- Primary CTA: Khám phá dự án with gradient & glow -->
          <a
            href="#projects"
            class="group relative inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 w-full sm:w-auto"
          >
            <span>Khám phá dự án</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>

          <!-- Secondary CTA: Liên hệ hợp tác with glass style -->
          <a
            href="#contact"
            class="group inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-medium text-slate-200 border border-white/10 hover:border-slate-400 bg-white/[0.04] hover:bg-white/[0.08] backdrop-blur-md hover:text-white hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 w-full sm:w-auto"
          >
            <svg class="w-4 h-4 text-slate-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <span>Liên hệ hợp tác</span>
          </a>
        </div>

        <!-- Tech Stack Highlights Pills -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-white/[0.07] w-full">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-mono font-semibold mr-1">Trọng tâm:</span>
          {['Java 17+', 'Spring Boot 3', 'Microservices', 'PostgreSQL', 'Redis', 'Docker', 'Angular', 'Kafka'].map((tech) => (
            <span class="text-xs px-2.5 py-1 rounded-md bg-white/[0.03] border border-white/[0.06] text-slate-300 font-mono hover:border-blue-500/30 hover:text-blue-300 transition-colors">
              {tech}
            </span>
          ))}
        </div>

      </div>

      <!-- Right Column: Interactive Code & Architecture Showcase Terminal -->
      <div class="lg:col-span-5 relative z-10 w-full">
        <!-- Ambient decorative halo behind terminal -->
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-600/20 via-indigo-600/20 to-cyan-500/20 rounded-2xl blur-xl opacity-70 group-hover:opacity-100 transition duration-1000"></div>

        <div class="relative rounded-2xl border border-white/[0.1] bg-[#0c121e]/90 backdrop-blur-xl shadow-2xl overflow-hidden">
          
          <!-- Terminal Header Bar -->
          <div class="flex items-center justify-between px-4 py-3 bg-[#090d16] border-b border-white/[0.08]">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="ml-2 text-xs font-mono text-slate-400">OrderProcessingService.java</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                ACTIVE
              </span>
            </div>
          </div>

          <!-- Code Content -->
          <div class="p-5 font-mono text-xs sm:text-sm text-slate-300 leading-relaxed overflow-x-auto space-y-1">
            <p class="text-slate-500">// Distributed Microservice Architecture</p>
            <p><span class="text-indigo-400">@Service</span></p>
            <p><span class="text-indigo-400">@RequiredArgsConstructor</span></p>
            <p><span class="text-blue-400">public class</span> <span class="text-emerald-300">OrderProcessingService</span> &#123;</p>
            <p class="pl-4"><span class="text-blue-400">private final</span> <span class="text-indigo-300">KafkaTemplate</span>&lt;<span class="text-amber-300">String, OrderEvent</span>&gt; <span class="text-slate-200">eventBus</span>;</p>
            <p class="pl-4"><span class="text-blue-400">private final</span> <span class="text-indigo-300">RedisCacheManager</span> <span class="text-slate-200">cache</span>;</p>
            <p class="pl-4 py-1 text-slate-500">// Non-blocking high throughput execution</p>
            <p class="pl-4"><span class="text-indigo-400">@Transactional</span></p>
            <p class="pl-4"><span class="text-blue-400">public</span> <span class="text-indigo-300">CompletableFuture</span>&lt;<span class="text-amber-300">Response</span>&gt; <span class="text-emerald-300">dispatch</span>(<span class="text-amber-300">Order</span> <span class="text-slate-200">cmd</span>) &#123;</p>
            <p class="pl-8 text-slate-300"><span class="text-blue-400">return</span> <span class="text-indigo-300">CompletableFuture</span>.<span class="text-blue-300">supplyAsync</span>(() -&gt; &#123;</p>
            <p class="pl-12 text-slate-300"><span class="text-slate-200">eventBus</span>.<span class="text-blue-300">send</span>(<span class="text-emerald-400">"orders.v1"</span>, <span class="text-slate-200">cmd</span>);</p>
            <p class="pl-12 text-blue-400"><span class="text-blue-400">return</span> <span class="text-indigo-300">Response</span>.<span class="text-blue-300">ok</span>(<span class="text-slate-200">cmd</span>.<span class="text-blue-300">getId</span>());</p>
            <p class="pl-8 text-slate-300">&#125;);</p>
            <p class="pl-4">&#125;</p>
            <p>&#125;</p>
          </div>

          <!-- Live Metrics Status Footer -->
          <div class="px-4 py-3 bg-[#080c14]/90 border-t border-white/[0.08] flex items-center justify-between text-[11px] font-mono text-slate-400">
            <div class="flex items-center gap-3">
              <span>P99: <strong class="text-emerald-400">14ms</strong></span>
              <span class="text-white/20">|</span>
              <span>TPS: <strong class="text-blue-400">12,500/s</strong></span>
            </div>
            <div class="flex items-center gap-1.5 text-slate-400">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>Java 21 LTS</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initTypewriter() {
    const typewriterElement = document.getElementById('hero-typewriter');
    if (!typewriterElement) return;

    // Respect reduced motion: leave default text intact
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const words = [
      "Java & Spring Boot",
      "Microservices Architecture",
      "High Performance APIs",
      "Full-Stack & Cloud Solutions"
    ];

    let wordIndex = 0;
    let charIndex = words[0].length;
    let isDeleting = true;
    let timer: number | undefined;

    function tick() {
      const currentWord = words[wordIndex];

      if (isDeleting) {
        charIndex--;
        typewriterElement.textContent = currentWord.substring(0, charIndex);

        if (charIndex <= 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          timer = window.setTimeout(tick, 350);
          return;
        }

        timer = window.setTimeout(tick, 35);
      } else {
        charIndex++;
        typewriterElement.textContent = currentWord.substring(0, charIndex);

        if (charIndex >= currentWord.length) {
          isDeleting = true;
          timer = window.setTimeout(tick, 2200);
          return;
        }

        timer = window.setTimeout(tick, 75);
      }
    }

    // Initial pause before deleting first pre-rendered text
    timer = window.setTimeout(tick, 2200);

    // Cleanup on document unload or page navigation
    const cleanup = () => {
      if (timer) clearTimeout(timer);
      document.removeEventListener('astro:before-swap', cleanup);
    };
    document.addEventListener('astro:before-swap', cleanup);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTypewriter);
  } else {
    initTypewriter();
  }
  document.addEventListener('astro:page-load', initTypewriter);
</script>
