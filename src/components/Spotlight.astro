---
// Spotlight.astro - Ambient interactive spotlight following cursor with smooth rAF interpolation
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
  <!-- Interactive Cursor Following Glow -->
  <div
    id="ambient-spotlight"
    class="pointer-events-none absolute -top-[350px] -left-[350px] w-[700px] h-[700px] rounded-full opacity-0 transition-opacity duration-700 ease-out will-change-transform"
    style="background: radial-gradient(circle at center, rgba(59, 130, 246, 0.14) 0%, rgba(99, 102, 241, 0.07) 35%, rgba(6, 182, 212, 0.02) 60%, transparent 75%); filter: blur(40px);"
  >
  </div>

  <!-- Subtle Ambient Stationary Background Accents for Depth -->
  <div
    class="pointer-events-none absolute top-[-10%] left-[15%] w-[500px] h-[500px] rounded-full bg-blue-600/[0.04] blur-[120px]"
  ></div>
  <div
    class="pointer-events-none absolute top-[35%] right-[-10%] w-[600px] h-[600px] rounded-full bg-indigo-600/[0.03] blur-[140px]"
  ></div>
</div>

<script>
  function initSpotlight() {
    const spotlight = document.getElementById('ambient-spotlight');
    if (!spotlight) return;

    // Respect reduced motion preferences
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      spotlight.style.transform = `translate3d(${window.innerWidth / 2}px, ${window.innerHeight / 3}px, 0)`;
      spotlight.style.opacity = '0.5';
      return;
    }

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let currentX = targetX;
    let currentY = targetY;
    let isRunning = false;
    let hasMoved = false;

    // Smooth lerp factor (0.09 gives a fluid, natural trailing lag)
    const LERP_FACTOR = 0.09;

    function render() {
      const dx = targetX - currentX;
      const dy = targetY - currentY;
      const distance = Math.hypot(dx, dy);

      // Idle check: avoid unnecessary rAF when stationary to conserve battery/CPU
      if (distance < 0.2) {
        currentX = targetX;
        currentY = targetY;
        spotlight.style.transform = `translate3d(${Math.round(currentX)}px, ${Math.round(currentY)}px, 0)`;
        isRunning = false;
        return;
      }

      currentX += dx * LERP_FACTOR;
      currentY += dy * LERP_FACTOR;

      spotlight.style.transform = `translate3d(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px, 0)`;
      requestAnimationFrame(render);
    }

    function onPointerMove(e: PointerEvent) {
      targetX = e.clientX;
      targetY = e.clientY;

      if (!hasMoved) {
        hasMoved = true;
        spotlight.style.opacity = '1';
        currentX = targetX;
        currentY = targetY;
        spotlight.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
      }

      if (!isRunning) {
        isRunning = true;
        requestAnimationFrame(render);
      }
    }

    function onPointerLeave() {
      spotlight.style.opacity = '0.25';
    }

    function onPointerEnter() {
      if (hasMoved) {
        spotlight.style.opacity = '1';
      }
    }

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    document.addEventListener('pointerleave', onPointerLeave, { passive: true });
    document.addEventListener('pointerenter', onPointerEnter, { passive: true });
  }

  // Support both direct initial load and Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotlight);
  } else {
    initSpotlight();
  }
  document.addEventListener('astro:page-load', initSpotlight);
</script>
