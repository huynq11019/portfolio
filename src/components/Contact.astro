---
// Contact.astro - Interactive Contact & Collaboration Section for Huy NQ
const emailAddress = 'huynq1808@gmail.com';
const phoneNumber = '0925573154';
const githubUrl = 'https://github.com/huynq11019';
const cvUrl = '/cv/Nguyen-Quang-Huy-CV.pdf';
---

<section id="contact" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Ambient background glow accents -->
  <div class="pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-b from-blue-600/10 via-indigo-600/5 to-transparent rounded-full blur-[140px]" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/[0.06] text-emerald-400 text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm shadow-emerald-500/10">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Get In Touch</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Kết nối &amp; Hợp tác kỹ thuật
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl leading-relaxed">
        Tôi luôn sẵn sàng trao đổi về các vị trí Backend / Full-Stack Engineer, kiến trúc hệ thống phân tán hoặc các dự án công nghệ đòi hỏi độ tin cậy và hiệu năng cao.
      </p>
    </div>

    <!-- Main Contact Card -->
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/[0.09] bg-[#0c121e]/85 shadow-2xl relative overflow-hidden">
      <!-- Decorative ambient halo -->
      <div class="absolute -top-32 -right-32 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        <!-- Left details column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
              Open for Opportunities
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
              Cùng xây dựng các sản phẩm công nghệ đột phá.
            </h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              Dù bạn đang tìm kiếm kỹ sư backend chủ lực, cần giải pháp tối ưu hóa cơ sở dữ liệu hay muốn trao đổi ý tưởng công nghệ mới, hãy để lại lời nhắn!
            </p>
          </div>

          <!-- Highlight contact features -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[11px] text-slate-400 font-mono">Thời gian phản hồi</span>
                <span class="text-xs font-semibold text-slate-200">Trong vòng 24 giờ</span>
              </div>
            </div>

            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
              <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[11px] text-slate-400 font-mono">Địa điểm làm việc</span>
                <span class="text-xs font-semibold text-slate-200">Mỹ Đình, Hà Nội &amp; Remote</span>
              </div>
            </div>

            <a
              href={`tel:${phoneNumber}`}
              class="flex items-center gap-3 p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.06] hover:border-cyan-500/30 transition-all group"
            >
              <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shrink-0 group-hover:scale-105 transition-transform">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H3.623A2.25 2.25 0 001.373 4.5v2.25z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[11px] text-slate-400 font-mono">Điện thoại / Zalo</span>
                <span class="text-xs font-semibold text-slate-200 group-hover:text-cyan-300 transition-colors">{phoneNumber}</span>
              </div>
            </a>

            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/[0.06]">
              <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[11px] text-slate-400 font-mono">Trạng thái sẵn sàng</span>
                <span class="text-xs font-semibold text-slate-200">Sẵn sàng nhận dự án mới</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right action card column -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <!-- Interactive Email Box with One-Click Copy -->
          <div class="p-5 rounded-2xl bg-[#080d16]/90 border border-white/[0.08] flex flex-col gap-3 relative shadow-inner">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span class="font-mono flex items-center gap-1.5">
                <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                Email liên hệ trực tiếp:
              </span>
              <span id="copy-tooltip" class="opacity-0 transition-opacity duration-300 text-[11px] font-mono font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                Đã sao chép!
              </span>
            </div>

            <!-- Email Display -->
            <div class="p-3 rounded-xl bg-black/40 border border-white/[0.05] flex items-center justify-between font-mono text-sm text-cyan-300 select-all overflow-x-auto">
              <span id="target-email">{emailAddress}</span>
            </div>

            <!-- Copy Button with Feedback -->
            <button
              type="button"
              id="copy-email-btn"
              data-email={emailAddress}
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl font-semibold text-xs text-white bg-blue-600 hover:bg-blue-500 active:scale-[0.98] transition-all duration-200 shadow-lg shadow-blue-500/20 focus:outline-none focus:ring-2 focus:ring-blue-400"
            >
              <svg id="copy-icon" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.849A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.599m9.332 0c.053.307.08.62.08.941v1.125c0 .621-.504 1.125-1.125 1.125H8.25M15.666 3.849c-.47-.215-.992-.349-1.541-.349h-4.25c-.55 0-1.072.134-1.541.349m0 0A2.25 2.25 0 006 6v13.5A2.25 2.25 0 008.25 21.75h7.5A2.25 2.25 0 0018 19.5V6a2.25 2.25 0 00-2.334-2.151z" />
              </svg>
              <svg id="check-icon" class="w-4 h-4 text-emerald-300 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span id="copy-btn-text">Sao chép địa chỉ Email</span>
            </button>
          </div>

          <!-- Direct Phone Box with One-Click Call / Copy -->
          <div class="p-5 rounded-2xl bg-[#080d16]/90 border border-white/[0.08] flex flex-col gap-3 relative shadow-inner">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span class="font-mono flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H3.623A2.25 2.25 0 001.373 4.5v2.25z" />
                </svg>
                Hotline / Điện thoại trực tiếp:
              </span>
              <span id="copy-phone-tooltip" class="opacity-0 transition-opacity duration-300 text-[11px] font-mono font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                Đã sao chép!
              </span>
            </div>

            <!-- Phone Display -->
            <div class="p-3 rounded-xl bg-black/40 border border-white/[0.05] flex items-center justify-between font-mono text-sm text-emerald-300 select-all">
              <span id="target-phone">{phoneNumber}</span>
              <span class="text-[11px] text-slate-400 font-sans">Mỹ Đình, Hà Nội</span>
            </div>

            <!-- Phone Actions: Call Now & Copy -->
            <div class="grid grid-cols-2 gap-2">
              <a
                href={`tel:${phoneNumber}`}
                class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl font-semibold text-xs text-white bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] transition-all duration-200 shadow-md shadow-emerald-600/20 focus:outline-none focus:ring-2 focus:ring-emerald-400"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H3.623A2.25 2.25 0 001.373 4.5v2.25z" />
                </svg>
                <span>Gọi ngay</span>
              </a>

              <button
                type="button"
                id="copy-phone-btn"
                data-phone={phoneNumber}
                class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl font-medium text-xs text-slate-200 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] hover:border-slate-500 active:scale-[0.98] transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-slate-400"
              >
                <svg id="copy-phone-icon" class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.849A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.599m9.332 0c.053.307.08.62.08.941v1.125c0 .621-.504 1.125-1.125 1.125H8.25M15.666 3.849c-.47-.215-.992-.349-1.541-.349h-4.25c-.55 0-1.072.134-1.541.349m0 0A2.25 2.25 0 006 6v13.5A2.25 2.25 0 008.25 21.75h7.5A2.25 2.25 0 0018 19.5V6a2.25 2.25 0 00-2.334-2.151z" />
                </svg>
                <svg id="check-phone-icon" class="w-3.5 h-3.5 text-emerald-300 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span id="copy-phone-btn-text">Sao chép số</span>
              </button>
            </div>
          </div>

          <!-- Secondary Actions: Direct CV Download, Mailto & GitHub Profile -->
          <div class="flex flex-col gap-2.5">
            <a
              href={cvUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl font-semibold text-xs text-blue-300 bg-blue-500/10 hover:bg-blue-500/20 border border-blue-500/30 hover:border-blue-400 hover:text-white transition-all duration-200 shadow-md shadow-blue-500/10 active:scale-[0.98]"
            >
              <svg class="w-4 h-4 text-blue-400 group-hover:text-blue-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span>Tải bản CV đầy đủ (PDF)</span>
            </a>

            <div class="grid grid-cols-2 gap-2.5">
              <a
                href={`mailto:${emailAddress}`}
                class="inline-flex items-center justify-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-slate-500 transition-colors"
              >
                <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
                <span>Gửi thư ngay</span>
              </a>

              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-slate-500 transition-colors"
              >
                <svg class="w-3.5 h-3.5 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                <span>GitHub Profile</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupCopyButtons() {
    // Setup email copy
    const emailBtn = document.getElementById('copy-email-btn');
    const emailBtnText = document.getElementById('copy-btn-text');
    const emailCopyIcon = document.getElementById('copy-icon');
    const emailCheckIcon = document.getElementById('check-icon');
    const emailTooltip = document.getElementById('copy-tooltip');

    if (emailBtn && !emailBtn.dataset.bound) {
      emailBtn.dataset.bound = 'true';
      let emailTimeout: number | undefined;

      emailBtn.addEventListener('click', async () => {
        const email = emailBtn.getAttribute('data-email') || 'huynq1808@gmail.com';
        await copyToClipboard(email);

        if (emailBtnText) emailBtnText.textContent = 'Đã sao chép vào bộ nhớ tạm!';
        emailCopyIcon?.classList.add('hidden');
        emailCheckIcon?.classList.remove('hidden');
        emailBtn.classList.remove('bg-blue-600', 'hover:bg-blue-500');
        emailBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-500', 'text-white');

        if (emailTooltip) {
          emailTooltip.classList.remove('opacity-0');
          emailTooltip.classList.add('opacity-100');
        }

        if (emailTimeout) clearTimeout(emailTimeout);

        emailTimeout = window.setTimeout(() => {
          if (emailBtnText) emailBtnText.textContent = 'Sao chép địa chỉ Email';
          emailCopyIcon?.classList.remove('hidden');
          emailCheckIcon?.classList.add('hidden');
          emailBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
          emailBtn.classList.add('bg-blue-600', 'hover:bg-blue-500');

          if (emailTooltip) {
            emailTooltip.classList.remove('opacity-100');
            emailTooltip.classList.add('opacity-0');
          }
        }, 2600);
      });
    }

    // Setup phone copy
    const phoneBtn = document.getElementById('copy-phone-btn');
    const phoneBtnText = document.getElementById('copy-phone-btn-text');
    const phoneCopyIcon = document.getElementById('copy-phone-icon');
    const phoneCheckIcon = document.getElementById('check-phone-icon');
    const phoneTooltip = document.getElementById('copy-phone-tooltip');

    if (phoneBtn && !phoneBtn.dataset.bound) {
      phoneBtn.dataset.bound = 'true';
      let phoneTimeout: number | undefined;

      phoneBtn.addEventListener('click', async () => {
        const phone = phoneBtn.getAttribute('data-phone') || '0925573154';
        await copyToClipboard(phone);

        if (phoneBtnText) phoneBtnText.textContent = 'Đã sao chép!';
        phoneCopyIcon?.classList.add('hidden');
        phoneCheckIcon?.classList.remove('hidden');
        phoneBtn.classList.add('text-emerald-300', 'border-emerald-500/40');

        if (phoneTooltip) {
          phoneTooltip.classList.remove('opacity-0');
          phoneTooltip.classList.add('opacity-100');
        }

        if (phoneTimeout) clearTimeout(phoneTimeout);

        phoneTimeout = window.setTimeout(() => {
          if (phoneBtnText) phoneBtnText.textContent = 'Sao chép số';
          phoneCopyIcon?.classList.remove('hidden');
          phoneCheckIcon?.classList.add('hidden');
          phoneBtn.classList.remove('text-emerald-300', 'border-emerald-500/40');

          if (phoneTooltip) {
            phoneTooltip.classList.remove('opacity-100');
            phoneTooltip.classList.add('opacity-0');
          }
        }, 2600);
      });
    }
  }

  async function copyToClipboard(text: string) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        document.execCommand('copy');
        textArea.remove();
      }
    } catch (err) {
      console.error('Không thể sao chép văn bản:', err);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopyButtons);
  } else {
    setupCopyButtons();
  }
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
