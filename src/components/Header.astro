---
// Header.astro - Modern Dark Glassmorphic Navbar for Huy NQ Portfolio
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/[0.08] bg-[#080c14]/80 backdrop-blur-xl transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Brand Logo / Name -->
      <a href="#" class="group flex items-center gap-3 shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-lg">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-500 via-indigo-500 to-cyan-400 p-[1px] shadow-lg shadow-blue-500/20 group-hover:shadow-blue-500/40 transition-shadow">
          <div class="w-full h-full bg-[#0a0d14] rounded-[11px] flex items-center justify-center">
            <span class="text-xs font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">
              HN
            </span>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-base tracking-tight text-white group-hover:text-blue-300 transition-colors">
            Huy NQ
          </span>
          <span class="text-[10px] text-slate-400 -mt-1 font-mono tracking-wide">
            Backend & Full-Stack
          </span>
        </div>
      </a>

      <!-- Status Beacon Badge (Desktop/Tablet) -->
      <div class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shadow-sm shadow-emerald-500/10 shrink-0">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Sẵn sàng cho cơ hội mới</span>
      </div>

      <!-- Navigation & Social Links -->
      <div class="flex items-center gap-1 sm:gap-2">
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-300" aria-label="Main Navigation">
          <a href="#about" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-white/[0.05] transition-colors">Giới thiệu</a>
          <a href="#skills" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-white/[0.05] transition-colors">Kỹ năng</a>
          <a href="#projects" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-white/[0.05] transition-colors">Dự án</a>
          <a href="#contact" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-white/[0.05] transition-colors">Liên hệ</a>
        </nav>

        <div class="h-4 w-px bg-white/10 hidden md:block mx-1"></div>

        <!-- GitHub Profile Button -->
        <a
          href="https://github.com/huynq11019"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile (huynq11019)"
          class="p-2 text-slate-400 hover:text-white hover:bg-white/[0.06] rounded-lg border border-white/[0.08] hover:border-slate-500 transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden p-2 text-slate-400 hover:text-white hover:bg-white/[0.06] rounded-lg border border-white/[0.08]"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-4 h-4 block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-nav-menu" class="hidden md:hidden border-t border-white/[0.08] bg-[#0a0d14]/95 backdrop-blur-2xl px-4 py-4 space-y-2">
    <div class="sm:hidden pb-3 mb-2 border-b border-white/[0.06] flex items-center justify-between">
      <span class="text-xs text-slate-400">Trạng thái:</span>
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Sẵn sàng cho cơ hội mới</span>
      </div>
    </div>
    <a href="#about" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-white/[0.05] transition-colors">Giới thiệu</a>
    <a href="#skills" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-white/[0.05] transition-colors">Kỹ năng</a>
    <a href="#projects" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-white/[0.05] transition-colors">Dự án</a>
    <a href="#contact" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-white/[0.05] transition-colors">Liên hệ</a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-nav-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && menu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
