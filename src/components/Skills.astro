---
// Skills.astro - Core Technical Skills Grid for Huy NQ Portfolio
interface SkillCategory {
  title: string;
  icon: string;
  gradient: string;
  borderHover: string;
  titleHover: string;
  dotColor: string;
  pillHover: string;
  description: string;
  skills: { name: string; focus: string; tag?: string }[];
}

const skillCategories: SkillCategory[] = [
  {
    title: 'Backend Architecture & High Performance',
    icon: 'server',
    gradient: 'from-blue-500/10 via-indigo-500/5 to-transparent',
    borderHover: 'group-hover:border-blue-500/40',
    titleHover: 'group-hover:text-blue-300',
    dotColor: 'bg-blue-400 shadow-blue-400/50',
    pillHover: 'hover:border-blue-500/30',
    description: 'Thiết kế kiến trúc hướng dịch vụ microservices, domain-driven design, phát triển SDK lõi dùng chung và bảo mật định danh eKYC chuẩn enterprise.',
    skills: [
      { name: 'Java 17+', focus: 'Multithreading, Stream API, OOP, Concurrency', tag: 'Core' },
      { name: 'Spring Boot', focus: 'REST API, Spring Data JPA, MVC', tag: 'Framework' },
      { name: 'DDD & CQRS', focus: 'Domain Modeling, Event-Driven Architecture', tag: 'Architecture' },
      { name: 'Microservices', focus: 'Service Discovery, API Gateway, Resilience', tag: 'System' },
      { name: 'SDK Development', focus: 'Shared Client SDKs, Internal Core Libs', tag: 'SDK' },
      { name: 'Spring Security & eKYC', focus: 'JWT, OAuth2, Biometric Verification', tag: 'Security' },
      { name: 'RESTful APIs', focus: 'OpenAPI, Swagger, Contract-First Design', tag: 'API' },
    ],
  },
  {
    title: 'Databases, Streaming & Data Warehouse',
    icon: 'database',
    gradient: 'from-emerald-500/10 via-teal-500/5 to-transparent',
    borderHover: 'group-hover:border-emerald-500/40',
    titleHover: 'group-hover:text-emerald-300',
    dotColor: 'bg-emerald-400 shadow-emerald-400/50',
    pillHover: 'hover:border-emerald-500/30',
    description: 'Quản trị cơ sở dữ liệu quan hệ/OLAP quy mô lớn, streaming event thời gian thực, CDC pipeline và hạ tầng StarRocks Data Warehouse cho BI.',
    skills: [
      { name: 'PostgreSQL', focus: 'Query Optimization, Indexing, Partitioning', tag: 'RDBMS' },
      { name: 'MySQL', focus: 'Schema Design, Replication, ACID Transactions', tag: 'RDBMS' },
      { name: 'Oracle Database', focus: 'Enterprise DB, PL/SQL, High-Volume', tag: 'Enterprise' },
      { name: 'StarRocks (Data Warehouse / BI)', focus: 'MPP Engine, Sub-second OLAP, Real-time BI', tag: 'OLAP / BI' },
      { name: 'CDC (Change Data Capture)', focus: 'Real-time Replication, Event Sync Pipeline', tag: 'Pipeline' },
      { name: 'Apache Kafka', focus: 'Event Streaming, Pub/Sub, High-Throughput', tag: 'Streaming' },
      { name: 'Redis', focus: 'In-Memory Caching, Distributed Locks, Pub/Sub', tag: 'Cache' },
      { name: 'RabbitMQ', focus: 'Message Broker, Routing, AMQP Decoupling', tag: 'Queue' },
    ],
  },
  {
    title: 'Modern Frontend & Micro-Frontend',
    icon: 'device',
    gradient: 'from-purple-500/10 via-indigo-500/5 to-transparent',
    borderHover: 'group-hover:border-purple-500/40',
    titleHover: 'group-hover:text-purple-300',
    dotColor: 'bg-purple-400 shadow-purple-400/50',
    pillHover: 'hover:border-purple-500/30',
    description: 'Kiến trúc micro-frontend module hóa (Vue/Angular), phát triển Single Page Applications hiện đại và giao diện responsive chuẩn UX.',
    skills: [
      { name: 'Micro-frontend Architecture', focus: 'Module Federation, Single-SPA, Sub-apps', tag: 'Architecture' },
      { name: 'Angular (v16+)', focus: 'Standalone Components, RxJS, NgRx, Services', tag: 'Framework' },
      { name: 'Vue 3', focus: 'Composition API, Pinia, Single-SPA Console', tag: 'Framework' },
      { name: 'React', focus: 'Hooks, State Management, Modern UI Components', tag: 'Library' },
      { name: 'TypeScript', focus: 'Strict Typing, Modern ECMAScript, Interfaces', tag: 'Language' },
      { name: 'Tailwind CSS', focus: 'Responsive Design, Custom Theme, Design Tokens', tag: 'UI/UX' },
    ],
  },
  {
    title: 'DevOps, Cloud & QA Engineering',
    icon: 'cloud',
    gradient: 'from-cyan-500/10 via-blue-500/5 to-transparent',
    borderHover: 'group-hover:border-cyan-500/40',
    titleHover: 'group-hover:text-cyan-300',
    dotColor: 'bg-cyan-400 shadow-cyan-400/50',
    pillHover: 'hover:border-cyan-500/30',
    description: 'Tự động hóa CI/CD Jenkins, điều phối container Kubernetes trên GCP/AWS, kiểm thử tải JMeter và bảo đảm chất lượng API toàn diện.',
    skills: [
      { name: 'Kubernetes (K8S)', focus: 'Cluster Deployments, Ingress, Pod Scaling', tag: 'DevOps' },
      { name: 'Google Cloud Platform (GCP)', focus: 'Cloud Run, GKE, IAM, Cloud Storage', tag: 'Cloud' },
      { name: 'AWS Cloud', focus: 'EC2, S3, RDS, Cloud Architecture & Deploy', tag: 'Cloud' },
      { name: 'Docker', focus: 'Containerization, Multi-stage Builds, Compose', tag: 'Containers' },
      { name: 'Jenkins CI/CD', focus: 'Automated Pipelines, Build & Deployment', tag: 'CI/CD' },
      { name: 'Agentic AI Dev Tools', focus: 'Claude Code, Cursor, GitHub Copilot (Rapid Delivery & Review)', tag: 'AI Tools' },
      { name: 'AI Agents & N8N', focus: 'Workflow Automation, Internal Operations Optimization', tag: 'Automation' },
      { name: 'JMeter (Load test)', focus: 'Stress Testing, Concurrency, Bottlenecks', tag: 'Testing' },
      { name: 'Mockito', focus: 'Mocking Framework, Integration Testing, TDD', tag: 'Testing' },
      { name: 'JUnit', focus: 'Unit Testing, Test Automation, Code Coverage', tag: 'QA' },
      { name: 'APIDog', focus: 'API Design, Mock Server, Automated Test Suites', tag: 'API Tool' },
    ],
  },
];
---

<section id="skills" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Subtle ambient decorative glow -->
  <div class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-blue-600/[0.04] rounded-full blur-[140px]" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-blue-500/20 bg-blue-500/[0.06] text-blue-400 text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm shadow-blue-500/10">
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
        <span>Technical Arsenal</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Năng lực công nghệ cốt lõi
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl leading-relaxed">
        Bộ kỹ năng thực chiến được áp dụng vào thiết kế hệ thống backend chịu tải, luồng dữ liệu an toàn và trải nghiệm ứng dụng hiện đại.
      </p>
    </div>

    <!-- Skills 4-Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {skillCategories.map((cat) => (
        <div class={`glass-panel glow-hover group relative rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 border border-white/[0.08] ${cat.borderHover} bg-[#0b101c]/80`}>
          <!-- Top subtle category gradient highlight -->
          <div class={`absolute inset-0 bg-gradient-to-br ${cat.gradient} opacity-50 rounded-2xl pointer-events-none transition-opacity duration-300 group-hover:opacity-100`}></div>

          <div class="relative z-10 flex flex-col h-full">
            <!-- Category Title & Icon -->
            <div class="flex items-center justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/[0.05] border border-white/[0.1] flex items-center justify-center text-blue-400 group-hover:scale-105 group-hover:bg-blue-500/10 group-hover:border-blue-500/30 transition-all duration-300 shadow-inner">
                  {cat.icon === 'server' && (
                    <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.75 5.1a3 3 0 012.4-1.1h7.7a3 3 0 012.4 1.1l2.1 3.45a4.5 4.5 0 01.9 2.7" />
                    </svg>
                  )}
                  {cat.icon === 'database' && (
                    <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                    </svg>
                  )}
                  {cat.icon === 'device' && (
                    <svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                    </svg>
                  )}
                  {cat.icon === 'cloud' && (
                    <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                    </svg>
                  )}
                </div>
                <h3 class={`text-xl font-bold text-white ${cat.titleHover} transition-colors`}>
                  {cat.title}
                </h3>
              </div>
              <span class="text-xs font-mono text-slate-500 group-hover:text-slate-400 transition-colors">
                {cat.skills.length} skills
              </span>
            </div>

            <!-- Description -->
            <p class="text-sm text-slate-400 leading-relaxed mb-6">
              {cat.description}
            </p>

            <!-- Skill Badges/Pills -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {cat.skills.map((skill) => (
                <div class={`flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.05] ${cat.pillHover} transition-all duration-200`}>
                  <div class="flex items-center gap-2 min-w-0">
                    <span class={`w-1.5 h-1.5 rounded-full shrink-0 shadow-sm ${cat.dotColor}`}></span>
                    <div class="flex flex-col min-w-0">
                      <span class="text-xs sm:text-sm font-semibold text-slate-200 truncate" title={skill.name}>
                        {skill.name}
                      </span>
                      <span class="text-[10px] text-slate-400 font-mono truncate" title={skill.focus}>
                        {skill.focus}
                      </span>
                    </div>
                  </div>
                  {skill.tag && (
                    <span class="text-[9px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded bg-white/[0.04] text-slate-400 shrink-0 border border-white/[0.05] ml-2">
                      {skill.tag}
                    </span>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
